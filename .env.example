# Telegram (required - get from my.telegram.org)
API_ID=12345678
API_HASH=your_api_hash_here

# Telegram Bot (required - get from @BotFather)
BOT_TOKEN=123456:ABCdefGHIjklMNOpqrsTUVwxyz

# Pyrogram User Session (required - run setup_session.py to generate)
SESSION_STRING=1BVtsOHIBAAAA...long_string_here

# Telegram Channel (required - your channel ID)
CHANNEL_ID=-1001234567890

# Your Telegram User ID (required - message @userinfobot to get it)
OWNER_ID=987654321

# Your public URL (required - set after Render deploys)
BASE_URL=https://telestr.onrender.com

# TMDb API Key (optional - for auto-posters and IMDB matching)
TMDB_API_KEY=
